#!name=Mob Control - Progression
#!desc=金幣、卡包刷新、季票倍率、連勝時間、建築加速與升級需求測試。移除設定請求條件快取標頭以處理304；實際效果待遊戲內驗證。
#!category=Gaming
#!arguments=TowerCoins:100000,EgsCoins:5000,EgsFullBar:5000,CardTierMultipliers:10|15|45|180,LeagueScale:100,CurrencyScale:100,DiminishingFactor:1,UndiminishedMilestones:10,WinStreakBonus:5,EndBarResources:200,SeasonPassType1Scale:2,ShieldBreakingResources:300,CastleRaidEndBarResources:400,CardPackRefreshSeconds:3600,SeasonPassType2Scale:2,SeasonPassType7Scale:2,SeasonPackScale:2,BonusDurationSeconds:1800,BonusCooldownSeconds:1800,BricksPerMinute:3000,FireRateCostScale:1,LegendsCostScale:1,LegendsGainScale:2,ArrowSpeedMin:0.5,ArrowSpeedMax:0.5,InterstitialGameGap:10,InterstitialGapSeconds:600
#!arguments-desc=InterstitialGameGap=插頁廣告局數間隔參數，預設10（原3）；InterstitialGapSeconds=插頁廣告時間間隔，預設600秒（原30）；兩者實際組合規則待測。ArrowSpeedMin/ArrowSpeedMax=倍率轉盤箭頭速度，預設各0.5（原各1），效果待測；金幣沿用來源模組；所有Scale為原值乘數，1不變。結算條200/300/400恢復原值，用途待確認；卡包刷新3600秒；季票各獎勵與卡包x2；連勝持續/冷卻1800秒；加速3000磚/分鐘；射速費用與Legends需求x1（保留原值），Legends經驗x2。正值參數設0不改。請停用舊模組避免重複改寫。

# Based on: https://github.com/jkgtw/Surge/blob/master/Gaming/MobControl-Coins.sgmodule
# 不要與來源模組同時啟用。倍率基於當次回應，不寫入玩家庫存。
# 未知設定索引與BreakableShields保留。Legends需求保留原值，僅經驗x2，效果待測。
# 僅修改設定 API，不能保證每種獎勵類型都使用這些參數。
# 不調整金幣餘額、伺服器存檔、購買驗證或付費會員；僅調整插頁廣告間隔，不修改獎勵影片領取流程。

# 只移除設定 API 的條件快取標頭，讓伺服器重新傳送本文供 jq 改寫。
# 不將無本文的 304 偽裝成 200；實際回應仍需擷取確認。
[Header Rewrite]
http-request ^https://remote-settings-v2\.voodoo-tech\.io/api/settings(?:\?|$) header-del If-None-Match
http-request ^https://remote-settings-v2\.voodoo-tech\.io/api/settings(?:\?|$) header-del If-Modified-Since

[Body Rewrite]
http-response-jq ^https:\/\/remote-settings-v2\.voodoo-tech\.io\/api\/settings(?:\?|$) 'def putNumber($p;$v): if ((try (getpath($p)|type) catch "null") == "number" and ($v|type)=="number") then setpath($p;$v) else . end; def putArray4($p;$a): if ((try (getpath($p)|type) catch "null") == "array" and ($a|length)==4 and all($a[];type=="number")) then setpath($p;$a) else . end; def scaleArray($p;$factor): if ($factor>0 and $factor!=1 and (try (getpath($p)|type) catch "null")=="array") then (getpath($p)) as $a | if all($a[];type=="number") then setpath($p;($a|map(. * $factor))) else . end else . end; def scaleSeasonPassType1($factor): ["_Game.SeasonPass.SeasonRemoteConfig",0,"RewardsModifierJson"] as $p | if ($factor>0 and $factor!=1 and (try (getpath($p)|type) catch "null")=="string") then (try (getpath($p)|fromjson) catch null) as $obj | if (($obj|type)=="object" and ($obj.RewardsMultiplierByArmoryTiers|type)=="array") then ($obj | .RewardsMultiplierByArmoryTiers |= map( if (.RewardType==1 and (.ArmoryTiersMultiplier|type)=="array" and all(.ArmoryTiersMultiplier[];type=="number")) then .ArmoryTiersMultiplier |= map(. * $factor) else . end )) as $new | setpath($p;($new|tojson)) else . end else . end; def positive($s): (try ($s|tonumber) catch 0) as $n | if $n>0 then $n else 0 end; def setPositive($p;$n): if $n>0 then putNumber($p;$n) else . end; def numericArray($a): if ($a|type)=="array" then all($a[];type=="number") else false end; def scaleCost($p;$f): if $f>0 and $f!=1 then (try (getpath($p)) catch null) as $a | if numericArray($a) then setpath($p;($a|map([1,(. * $f|floor)]|max))) else . end else . end; def seasonExtra($f2;$f7;$fp): ["_Game.SeasonPass.SeasonRemoteConfig",0,"RewardsModifierJson"] as $p | . as $original | try ( (getpath($p)|fromjson) as $o | if ($o|type)=="object" then ($o | if (.RewardsMultiplierByArmoryTiers|type)=="array" then .RewardsMultiplierByArmoryTiers |= map( (if .RewardType==2 then $f2 elif .RewardType==7 then $f7 else 1 end) as $f | if $f>0 and $f!=1 and numericArray(.ArmoryTiersMultiplier) then .ArmoryTiersMultiplier |= map(. * $f) else . end) else . end | if $fp>0 and $fp!=1 and (.BoosterPackMultiplierByArmoryTiers|type)=="array" then .BoosterPackMultiplierByArmoryTiers |= map(if numericArray(.ArmoryTiersMultiplier) then .ArmoryTiersMultiplier |= map(. * $fp) else . end) else . end) as $new | if $new==$o then $original else setpath($p;($new|tojson)) end else $original end ) catch $original; def legendsGain($f): ["_Game.Legends.LegendsConfiguration",0,"ExperienceGainPerCardJson"] as $p | . as $original | if $f>0 and $f!=1 then try ((getpath($p)|fromjson) as $o | if ($o.CardExperienceGainDataPerCard|type)=="array" then ($o | .CardExperienceGainDataPerCard |= map( if (.ExperienceDataPerLevel|type)=="array" then .ExperienceDataPerLevel |= map( if (.Experience|type)=="number" then .Experience = ([1,(.Experience * $f|floor)]|max) else . end ) else . end)) as $new | setpath($p;($new|tojson)) else $original end) catch $original else . end; ("{{{TowerCoins}}}" | tonumber? // 250) as $tower | ("{{{EgsCoins}}}" | tonumber? // 40) as $egs | ("{{{EgsFullBar}}}" | tonumber? // 40) as $bar | ("{{{CardTierMultipliers}}}" | split("|") | map(tonumber?)) as $cards | ("{{{LeagueScale}}}" | tonumber? // 1) as $league | ("{{{CurrencyScale}}}" | tonumber? // 1) as $currency | ("{{{DiminishingFactor}}}" | tonumber? // 0.5) as $diminish | ("{{{UndiminishedMilestones}}}" | tonumber? // 5) as $milestones | ("{{{WinStreakBonus}}}" | tonumber? // 2) as $streak | ("{{{EndBarResources}}}" | tonumber? // 200) as $endbar | ("{{{SeasonPassType1Scale}}}" | tonumber? // 1) as $season | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_TowerCoinsRewardByLeagueTier"];$tower) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_EgsCoinRewardByLeagueTier"];$egs) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_EgsFullBarCoinRewardByLeagueTier"];$bar) | putArray4(["_Game.Features.Voodoo.Live.Core.VoodooLiveConfig",0,"CoinsMultiplierByCardTier"];$cards) | scaleArray(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_LeagueMultiplier"];$league) | scaleArray(["_Game.Common.NewRewards.ScalableCurrencyConfiguration",0,"Multipliers"];$currency) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_DiminishingReturnFactor"];$diminish) | putNumber(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_UndiminishedMilestones"];$milestones) | putNumber(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusStateMultiplier"];$streak) | putNumber(["EndLevelSequenceConfig",0,"EndBarResources"];$endbar) | scaleSeasonPassType1($season) | setPositive(["EndLevelSequenceConfig",0,"ShieldBreakingResources"];positive("{{{ShieldBreakingResources}}}")) | setPositive(["EndLevelSequenceConfig",0,"CastleRaidEndBarResources"];positive("{{{CastleRaidEndBarResources}}}")) | setPositive(["_Game.Features.PeriodicCardPackQueue.Core.PeriodicCardPackQueueConfig",0,"RefreshIntervalInSeconds"];positive("{{{CardPackRefreshSeconds}}}")) | setPositive(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusStateDurationInSeconds"];positive("{{{BonusDurationSeconds}}}")) | setPositive(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusStateCooldownDurationInSeconds"];positive("{{{BonusCooldownSeconds}}}")) | setPositive(["_Game.Features.Meta.CityConfig",0,"BricksOverflowToAccelerateAMinute"];positive("{{{BricksPerMinute}}}")) | seasonExtra(positive("{{{SeasonPassType2Scale}}}");positive("{{{SeasonPassType7Scale}}}");positive("{{{SeasonPackScale}}}")) | scaleCost(["_Game.FireRate.FireRateConfiguration",0,"PricePerStep"];positive("{{{FireRateCostScale}}}")) | scaleCost(["_Game.Legends.LegendsConfiguration",0,"ExperienceCostPerLevel"];positive("{{{LegendsCostScale}}}")) | legendsGain(positive("{{{LegendsGainScale}}}")) | setPositive(["RvMultiplierConfiguration",0,"ArrowSpeedMin"];positive("{{{ArrowSpeedMin}}}")) | setPositive(["RvMultiplierConfiguration",0,"ArrowSpeedMax"];positive("{{{ArrowSpeedMax}}}")) | setPositive(["Voodoo.Sauce.Internal.Ads.AdFrequencyConfiguration",0,"maxGamesBetweenInterstitialAds"];positive("{{{InterstitialGameGap}}}")) | setPositive(["Voodoo.Sauce.Internal.Ads.AdFrequencyConfiguration",0,"delayInSecondsBetweenInterstitialAds"];positive("{{{InterstitialGapSeconds}}}"))'

[MITM]
hostname = %APPEND% remote-settings-v2.voodoo-tech.io
