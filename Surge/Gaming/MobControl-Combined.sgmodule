#!name=Mob Control - Combined
#!desc=整合精簡版：金幣收益、連勝、溢出磚塊加速、插頁廣告間隔與304修正。金幣已實測有效，其餘遊戲效果依實測確認。
#!category=Gaming
#!arguments=TowerCoins:100000,EgsCoins:5000,EgsFullBar:5000,DiminishingFactor:1,UndiminishedMilestones:10,CardTierMultipliers:10|15|45|180,LeagueScale:100,CurrencyScale:100,WinStreakBonus:5,BonusDurationSeconds:3600,BonusCooldownSeconds:60,WinStreakMaxTier:5,WinStreakMinLeague:1,WinStreakCastleRaidMinLevel:1,WinStreakInactivitySeconds:604800,InterstitialGameGap:10,InterstitialGapSeconds:600,WinStreakEnabled:1,WinStreakBonusEnabled:1,WinStreakResetCooldown:0,WinStreakInfoPopup:0,WinStreakFirstBonusPopup:0,WinStreakImprovedAnimations:1,BricksPerMinute:1500
#!arguments-desc=BricksPerMinute=每分鐘建築加速所需溢出磚塊，預設1500（原6000），0或負值不改；用途依名稱判讀、效果待測，不改總工時或Free門檻。金幣保留原設定；LeagueScale/CurrencyScale為原倍率乘數，1不變。連勝加成5、持續3600秒、冷卻60秒、閒置604800秒、階級上限5、聯盟/城堡門檻1；布林參數1開0關，-1不改。插頁廣告局數間隔10、時間間隔600秒；實際組合規則待測。請停用兩個舊模組後使用本模組。
# Based on: https://github.com/jkgtw/Surge/blob/master/Gaming/MobControl-Coins.sgmodule
# 不保證敗北後保持連勝；ConfigSheetName、Exploit欄位維持伺服器原值。
# 刪除：Season全部、倍率轉盤箭頭、卡包刷新、卡片/藍圖/卡包存檔、Flash Offers、道具/技能/建築存檔及Legends測試。
# 實測未達預期而刪除：攻城資源條、射速升級價格、射速道具庫存與Skip’Its差額。
# 溢出磚塊加速已恢復：BricksOverflowToAccelerateAMinute=1500；先前總工時未變不能判定此比例無效。
# 僅改遠端設定，不含/v2/storage改寫；金幣收益原有倍率與連勝加成保留。
# 停用舊模組不會自動復原先前可能已同步保存的玩家資料。

[Header Rewrite]
http-request ^https://remote-settings-v2\.voodoo-tech\.io/api/settings(?:\?|$) header-del If-None-Match
http-request ^https://remote-settings-v2\.voodoo-tech\.io/api/settings(?:\?|$) header-del If-Modified-Since

[Body Rewrite]
http-response-jq ^https:\/\/remote-settings-v2\.voodoo-tech\.io\/api\/settings(?:\?|$) 'def num($s): try ($s|tonumber) catch -1; def putnum($p;$v): if $v>0 and (try (getpath($p)|type) catch "null")=="number" then setpath($p;$v) else . end; def putbool($p;$v): if ($v==0 or $v==1) and (try (getpath($p)|type) catch "null")=="boolean" then setpath($p;($v==1)) else . end; def arr($p;$factor): if $factor>0 and $factor!=1 then (try getpath($p) catch null) as $a | if ($a|type)=="array" then if all($a[];type=="number") then setpath($p;($a|map(. * $factor))) else . end else . end else . end; def tiers($a): ["_Game.Features.Voodoo.Live.Core.VoodooLiveConfig",0,"CoinsMultiplierByCardTier"] as $p | if ($a|length)==4 and all($a[];type=="number" and .>0) and (try (getpath($p)|type) catch "null")=="array" then setpath($p;$a) else . end; . | putnum(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_TowerCoinsRewardByLeagueTier"];num("{{{TowerCoins}}}")) | putnum(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_EgsCoinRewardByLeagueTier"];num("{{{EgsCoins}}}")) | putnum(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_EgsFullBarCoinRewardByLeagueTier"];num("{{{EgsFullBar}}}")) | putnum(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_DiminishingReturnFactor"];num("{{{DiminishingFactor}}}")) | putnum(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_UndiminishedMilestones"];num("{{{UndiminishedMilestones}}}")) | putnum(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusStateMultiplier"];num("{{{WinStreakBonus}}}")) | putnum(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusStateDurationInSeconds"];num("{{{BonusDurationSeconds}}}")) | putnum(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusStateCooldownDurationInSeconds"];num("{{{BonusCooldownSeconds}}}")) | putnum(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"MaxTier"];num("{{{WinStreakMaxTier}}}")) | putnum(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"MinLeagueId"];num("{{{WinStreakMinLeague}}}")) | putnum(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"MinLevelForCastleRaid"];num("{{{WinStreakCastleRaidMinLevel}}}")) | putnum(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"InactivityLimitInSeconds"];num("{{{WinStreakInactivitySeconds}}}")) | putnum(["Voodoo.Sauce.Internal.Ads.AdFrequencyConfiguration",0,"maxGamesBetweenInterstitialAds"];num("{{{InterstitialGameGap}}}")) | putnum(["Voodoo.Sauce.Internal.Ads.AdFrequencyConfiguration",0,"delayInSecondsBetweenInterstitialAds"];num("{{{InterstitialGapSeconds}}}")) | putbool(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"Enabled"];num("{{{WinStreakEnabled}}}")) | putbool(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"BonusEnabled"];num("{{{WinStreakBonusEnabled}}}")) | putbool(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"IsResetCooldownEnabled"];num("{{{WinStreakResetCooldown}}}")) | putbool(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"IsInfoPopupEnabled"];num("{{{WinStreakInfoPopup}}}")) | putbool(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"IsFirstBonusInfoPopupEnabled"];num("{{{WinStreakFirstBonusPopup}}}")) | putbool(["_Game.Features.WinStreak.Core.WinStreakConfiguration",0,"UseImprovedBonusStateAnimations"];num("{{{WinStreakImprovedAnimations}}}")) | tiers(("{{{CardTierMultipliers}}}"|split("|")|map(try tonumber catch null))) | arr(["_Game.Features.CoinsIncome.Core.CoinsIncomeConfiguration",0,"m_LeagueMultiplier"];num("{{{LeagueScale}}}")) | arr(["_Game.Common.NewRewards.ScalableCurrencyConfiguration",0,"Multipliers"];num("{{{CurrencyScale}}}")) | putnum(["_Game.Features.Meta.CityConfig",0,"BricksOverflowToAccelerateAMinute"];num("{{{BricksPerMinute}}}"))'

[MITM]
hostname = %APPEND% remote-settings-v2.voodoo-tech.io
