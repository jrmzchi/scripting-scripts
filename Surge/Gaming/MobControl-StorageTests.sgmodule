#!name=Mob Control - Storage Tests
#!desc=玩家存檔回應實驗；所有修改預設關閉。可能被遊戲同步保存。請先保留原始封存，一次只開一項；未驗證遊戲效果。
#!category=Gaming
#!arguments=FireRatePowerUpCount:-1,CardPackRefreshUnix:-1,CardPackConsumed:-1,CardId:-1,CardCount:-1,CardUpgradeCoins:-1,CardBlueprints:-1,BuildingId:-1,UpgradeEarlierSeconds:0,JobEarlierSeconds:0,JobState:-1,SkipitsBalance:-1,ChargeSpeedLevel:-1
#!arguments-desc=-1不改，0可設為零；CardId/BuildingId=-1不選取。FireRatePowerUpCount=射速道具數；CardPackRefreshUnix=下次刷新Unix秒；CardPackConsumed=已消耗數。CardCount/CardUpgradeCoins/CardBlueprints=指定卡片張數/剩餘金幣/藍圖（只改已有欄位）。UpgradeEarlierSeconds/JobEarlierSeconds=指定建築開始時間提前秒數，0不改；JobState狀態意義未知先保留-1。SkipitsBalance=取得減已花費的目標差額，不改購買旗標；ChargeSpeedLevel原50，勿超出已知範圍。
# 可與 MobControl-Progression 同時使用，攔截不同 API。
# 只改 /v2/storage 的回應；不修改上傳請求、版本、使用者ID或購買權益。
# 但遊戲可能將收到的值寫回雲端，因此停用模組不保證復原。
# 不產生虛構Gift，不修改未知EGS重置時間。相同紀錄中省略的Id按0辨識。
# CardPackRefreshUnix例：0代表1970年，請使用有意義的Unix時間；NextRefresh輸出UTC Z格式。
[Body Rewrite]
http-response-jq ^https:\/\/public\.mobcontrol\.voodoo-gaming\.io\/v2\/storage(?:\?|$) 'def n($s): try ($s|tonumber) catch -1; def setnum($k;$v): if $v>=0 and (.[$k]|type)=="number" then .[$k]=($v|floor) else . end; def earlier($s;$delta): if $delta>0 and ($s|type)=="string" then try ($s|sub("\\.[0-9]+Z$";"Z")|fromdateiso8601|.-$delta|todateiso8601) catch $s else $s end; n("{{{FireRatePowerUpCount}}}") as $FireRatePowerUpCount | n("{{{CardPackRefreshUnix}}}") as $CardPackRefreshUnix | n("{{{CardPackConsumed}}}") as $CardPackConsumed | n("{{{CardId}}}") as $CardId | n("{{{CardCount}}}") as $CardCount | n("{{{CardUpgradeCoins}}}") as $CardUpgradeCoins | n("{{{CardBlueprints}}}") as $CardBlueprints | n("{{{BuildingId}}}") as $BuildingId | n("{{{UpgradeEarlierSeconds}}}") as $UpgradeEarlierSeconds | n("{{{JobEarlierSeconds}}}") as $JobEarlierSeconds | n("{{{JobState}}}") as $JobState | n("{{{SkipitsBalance}}}") as $SkipitsBalance | n("{{{ChargeSpeedLevel}}}") as $ChargeSpeedLevel | if (.objects|type)=="array" then .objects |= map( if .collection=="PlayerData" and (.value|type)=="string" then . as $record | try ( (.value|fromjson) as $old | ($old | if $record.key=="InventoryData" then if (.m_Items|type)=="object" then .m_Items |= setnum("FireRatePowerUp";$FireRatePowerUpCount) else . end elif $record.key=="PeriodicCardPackQueueData" then setnum("ConsumedElements";$CardPackConsumed) | if $CardPackRefreshUnix>=0 and (.NextRefresh|type)=="string" then .NextRefresh=($CardPackRefreshUnix|floor|todateiso8601) else . end elif $record.key=="SerializableArmory" and $CardId>=0 then (if (.Cards|type)=="array" then .Cards |= map( if ((.Id // 0)==$CardId) and (.State|type)=="object" then .State |= (setnum("RemainingCoinsToLevelUp";$CardUpgradeCoins)|setnum("Blueprints";$CardBlueprints)) else . end) else . end) | (if (.Decks|type)=="array" then .Decks |= map( if (.Value.AmountOfCardsPerId|type)=="array" then .Value.AmountOfCardsPerId |= map(if .Key==$CardId then setnum("Value";$CardCount) else . end) else . end) else . end) elif $record.key=="CityData" and $BuildingId>=0 then if (.Buildings|type)=="array" then .Buildings |= map( if (.Id // 0)==$BuildingId then (if (.UpgradeJobData.StartTime|type)=="string" then .UpgradeJobData.StartTime |= earlier(.;$UpgradeEarlierSeconds) else . end) | (if (.ScheduledJobs|type)=="array" then .ScheduledJobs |= map( (if (.StartTime|type)=="string" then .StartTime |= earlier(.;$JobEarlierSeconds) else . end) | setnum("State";$JobState)) else . end) else . end) else . end elif $record.key=="SkipetsData" then if $SkipitsBalance>=0 and (.m_SkipetsStorage.m_Earned|type)=="number" and (.m_SkipetsStorage.m_Spent|type)=="number" then .m_SkipetsStorage.m_Earned=(.m_SkipetsStorage.m_Spent+($SkipitsBalance|floor)) else . end elif $record.key=="PlayerData" then setnum("ChargeSpeedPercentageLevel";$ChargeSpeedLevel) else . end) as $new | if $old==$new then $record else .value=($new|tojson) end ) catch $record else . end) else . end'

[MITM]
hostname = %APPEND% public.mobcontrol.voodoo-gaming.io
