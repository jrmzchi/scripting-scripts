#!name=Mob Control - Storage Tests
#!desc=玩家存檔回應實驗；已啟用小量卡片、卡包累積值、商店數量及技能測試。可能被遊戲同步保存。請先保留原始封存，一次只開一項；未驗證遊戲效果。
#!category=Gaming
#!arguments=CardPackRefreshUnix:-1,CardPackConsumed:-1,CardId:5,CardCount:25,CardUpgradeCoins:-1,CardBlueprints:-1,BuildingId:-1,UpgradeEarlierSeconds:0,JobEarlierSeconds:0,JobState:-1,ChargeSpeedLevel:-1,PackPity:0.01,ShopCardId:2,ShopCardAmount:25,ShopCardPrice:-1,SkillId:3,SkillLevel:4,SeasonPoints:-1,SeasonTotalPoints:-1,PowerPathPoints:-1
#!arguments-desc=新增：PackPity=卡包累積值（非已知機率）；ShopCardId/ShopCardAmount/ShopCardPrice=指定商店卡片/數量/價格；SkillId/SkillLevel=指定技能/等級（名稱未知）；SeasonPoints/SeasonTotalPoints/PowerPathPoints=積分，預設-1不改。-1不改，0可設為零；CardId/BuildingId=-1不選取。CardPackRefreshUnix=下次刷新Unix秒；CardPackConsumed=已消耗數。CardCount/CardUpgradeCoins/CardBlueprints=指定卡片張數/剩餘金幣/藍圖（只改已有欄位）。UpgradeEarlierSeconds/JobEarlierSeconds=指定建築開始時間提前秒數，0不改；JobState狀態意義未知先保留-1。ChargeSpeedLevel原50，勿超出已知範圍。
# 2026-11-03 使用者實測無效：InventoryData.m_Items.FireRatePowerUp（仍需觀看影片）。
# 2026-11-03 使用者實測無效：SkipetsData.m_SkipetsStorage 收支差額（可用Skip’Its未增加）。
# 上述兩項已移除參數與執行分支，舊自訂值不再使用；不是把已存入的資料改回零。
# 建築加速、攻城條曾未觀察到效果，但尚未定位實際控制欄位；不列為已證實無效。
# 可與 MobControl-Progression 同時使用，攔截不同 API。
# 只改 /v2/storage 的回應；不修改上傳請求、版本、使用者ID或購買權益。
# 但遊戲可能將收到的值寫回雲端，因此停用模組不保證復原。
# 預設固定覆寫：卡片ID5張數25、PackAccumulatedPitty=0.01、商店卡片ID2數量25、技能ID3等級4。
# 每次下載皆覆寫為指定值，不是增量；遊戲可能忽略或同步。停用不保證復原。
# 不產生虛構Gift，不修改未知EGS重置時間。相同紀錄中省略的Id按0辨識。
# CardPackRefreshUnix例：0代表1970年，請使用有意義的Unix時間；NextRefresh輸出UTC Z格式。
[Body Rewrite]
http-response-jq ^https:\/\/public\.mobcontrol\.voodoo-gaming\.io\/v2\/storage(?:\?|$) 'def n($s): try ($s|tonumber) catch -1; def setnum($k;$v): if $v>=0 and (.[$k]|type)=="number" then .[$k]=($v|floor) else . end; def earlier($s;$delta): if $delta>0 and ($s|type)=="string" then try ($s|sub("\\.[0-9]+Z$";"Z")|fromdateiso8601|.-$delta|todateiso8601) catch $s else $s end; n("{{{CardPackRefreshUnix}}}") as $CardPackRefreshUnix | n("{{{CardPackConsumed}}}") as $CardPackConsumed | n("{{{CardId}}}") as $CardId | n("{{{CardCount}}}") as $CardCount | n("{{{CardUpgradeCoins}}}") as $CardUpgradeCoins | n("{{{CardBlueprints}}}") as $CardBlueprints | n("{{{BuildingId}}}") as $BuildingId | n("{{{UpgradeEarlierSeconds}}}") as $UpgradeEarlierSeconds | n("{{{JobEarlierSeconds}}}") as $JobEarlierSeconds | n("{{{JobState}}}") as $JobState | n("{{{ChargeSpeedLevel}}}") as $ChargeSpeedLevel | n("{{{PackPity}}}") as $PackPity | n("{{{ShopCardId}}}") as $ShopCardId | n("{{{ShopCardAmount}}}") as $ShopCardAmount | n("{{{ShopCardPrice}}}") as $ShopCardPrice | n("{{{SkillId}}}") as $SkillId | n("{{{SkillLevel}}}") as $SkillLevel | n("{{{SeasonPoints}}}") as $SeasonPoints | n("{{{SeasonTotalPoints}}}") as $SeasonTotalPoints | n("{{{PowerPathPoints}}}") as $PowerPathPoints | if (.objects|type)=="array" then .objects |= map( if .collection=="PlayerData" and (.value|type)=="string" then . as $record | try ( (.value|fromjson) as $old | ($old | if $record.key=="PeriodicCardPackQueueData" then setnum("ConsumedElements";$CardPackConsumed) | if $CardPackRefreshUnix>=0 and (.NextRefresh|type)=="string" then .NextRefresh=($CardPackRefreshUnix|floor|todateiso8601) else . end elif $record.key=="SerializableArmory" then (if $PackPity>=0 and (.PackAccumulatedPitty|type)=="number" then .PackAccumulatedPitty=$PackPity else . end) | (if $CardId>=0 then (if (.Cards|type)=="array" then .Cards |= map( if ((.Id // 0)==$CardId) and (.State|type)=="object" then .State |= (setnum("RemainingCoinsToLevelUp";$CardUpgradeCoins)|setnum("Blueprints";$CardBlueprints)) else . end) else . end) | (if (.Decks|type)=="array" then .Decks |= map( if (.Value.AmountOfCardsPerId|type)=="array" then .Value.AmountOfCardsPerId |= map(if .Key==$CardId then setnum("Value";$CardCount) else . end) else . end) else . end) else . end) elif $record.key=="CityData" and $BuildingId>=0 then if (.Buildings|type)=="array" then .Buildings |= map( if (.Id // 0)==$BuildingId then (if (.UpgradeJobData.StartTime|type)=="string" then .UpgradeJobData.StartTime |= earlier(.;$UpgradeEarlierSeconds) else . end) | (if (.ScheduledJobs|type)=="array" then .ScheduledJobs |= map( (if (.StartTime|type)=="string" then .StartTime |= earlier(.;$JobEarlierSeconds) else . end) | setnum("State";$JobState)) else . end) else . end) else . end elif $record.key=="ShopCardsOfferData" and $ShopCardId>=0 then if (.Cards|type)=="array" then .Cards |= map(if .CardDataId==$ShopCardId then setnum("Amount";$ShopCardAmount) | setnum("Price";$ShopCardPrice) else . end) else . end elif $record.key=="PlayerSkillsData" and $SkillId>=0 then if (.PlayerSkillDatas|type)=="array" then .PlayerSkillDatas |= map(if (.Id // 0)==$SkillId then setnum("Level";$SkillLevel) else . end) else . end elif $record.key=="SeasonsData" then setnum("m_SeasonPoints";$SeasonPoints) | setnum("m_TotalPoints";$SeasonTotalPoints) elif $record.key=="PowerPathData" then setnum("EarnedPoints";$PowerPathPoints) elif $record.key=="PlayerData" then setnum("ChargeSpeedPercentageLevel";$ChargeSpeedLevel) else . end) as $new | if $old==$new then $record else .value=($new|tojson) end ) catch $record else . end) else . end'

[MITM]
hostname = %APPEND% public.mobcontrol.voodoo-gaming.io
